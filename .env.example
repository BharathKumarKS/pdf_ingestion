# Synapse Learning Worlds -- Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -- App -----------------------------------------------------------------------
APP_NAME="Synapse Learning Worlds"
APP_VERSION="0.1.0"
DEBUG=false

# -- Database ------------------------------------------------------------------
SQLITE_URL="sqlite:///./data/synapse.db"

# -- Qdrant Vector DB ----------------------------------------------------------
# Three connection modes — only one should be active at a time:
#
# Mode A: Local file-based persistence (default, no server required for dev)
#   Leave QDRANT_URL and QDRANT_HOST blank. Data stored at QDRANT_LOCAL_PATH.
#
# Mode B: Self-hosted Qdrant server (Docker or VM)
#   Option 1 — set QDRANT_HOST + QDRANT_PORT:
#     QDRANT_HOST=192.168.1.100
#     QDRANT_PORT=6333
#   Option 2 — set QDRANT_URL (equivalent, accepts any URL):
#     QDRANT_URL=http://192.168.1.100:6333
#
# Mode C: Qdrant Cloud / Support Vectors remote cluster
#   QDRANT_URL=https://abc123xyz.cloud.qdrant.io
#   QDRANT_API_KEY=your-api-key

QDRANT_LOCAL_PATH=./data/qdrant      # used only in Mode A
QDRANT_COLLECTION=knowledge_base
QDRANT_IN_MEMORY=false               # set true for unit tests only

# Mode B — self-hosted server (leave blank for Mode A or C)
QDRANT_HOST=                         # e.g. 192.168.1.100 or qdrant.myserver.com
QDRANT_PORT=6333

# Mode C — remote cloud cluster (leave blank for Mode A or B)
QDRANT_URL=                          # e.g. https://abc123.cloud.qdrant.io
QDRANT_API_KEY=                      # only needed for cloud clusters with auth

# -- Embedding -- Jina v3 ------------------------------------------------------
# Downloads ~570 MB on first run, cached to MODEL_CACHE_DIR
EMBEDDING_MODEL=jinaai/jina-embeddings-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8          # CPU default; set 32 on GPU VM
USE_GPU=false                   # Set true on Support Vectors GPU VM (CUDA)
USE_STUB_EMBEDDER=false         # Set true for fast unit tests (random vectors)

# -- Chunking ------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_TOKENS=32

# -- LLM backend — Phase 2 (cards, RAPTOR) + Phase 3 (concept extraction) -----
# Set LLM_BACKEND to switch between local Ollama and any OpenAI-compatible server.
# No ollama pull / ollama serve needed when using the openai backend.
LLM_BACKEND=ollama              # "ollama" | "openai"

# Ollama settings (used when LLM_BACKEND=ollama)
# Requires: ollama serve && ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120              # seconds per generation call

# OpenAI-compatible settings (used when LLM_BACKEND=openai)
# Works with vLLM, LiteLLM, Together AI, Anyscale, Azure OpenAI, etc.
# Point OPENAI_API_BASE at your cluster endpoint — no ollama needed.
OPENAI_API_BASE=http://localhost:8000
OPENAI_API_KEY=none             # set to actual key if your server requires auth
OPENAI_MODEL=meta-llama/Llama-3.2-8B-Instruct

USE_STUB_LLM=false              # set true to skip all LLM calls in unit tests

# -- Phase 4 — Intent Router ---------------------------------------------------
# Classifies queries and activates only the relevant retrieval routes.
# Factual queries skip RAPTOR + GraphRAG; visual queries use ColPali only.
# Set false to use manual route selection (admin checkboxes always override).
INTENT_ROUTER_ENABLED=true
INTENT_CLASSIFIER_PATH=data/models/intent_classifier.pkl

# -- Phase 4 — Cross-encoder Re-ranker -----------------------------------------
# Re-scores retrieved chunks by jointly encoding (query, passage) pairs.
# Catches relevance that embedding cosine similarity misses.
# Model: cross-encoder/ms-marco-MiniLM-L-6-v2 (~80MB download, CPU-friendly)
#
# ⚠️  LAPTOP: set RERANKER_ENABLED=false to avoid loading a second large model
#     alongside Jina v3 — two models in RAM causes "Aw Snap" browser crashes.
#     GPU VM: keep true, the reranker adds ~50ms and noticeably improves quality.
RERANKER_ENABLED=false          # set true on GPU VM
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=6                # final chunks shown after re-ranking
RERANKER_FETCH_K=20             # candidates retrieved before re-ranking
USE_STUB_RERANKER=false

# -- Phase 4 — DA (Derivative Artifact) Retrieval Lane -------------------------
# Searches definition/formula/question/factoid cards as a recall-only lane.
# DA hits expand results without displacing top dense hits.
# Requires: run index_derivative_artifacts.py after Phase 2.
DA_ENABLED=true

# -- Phase 4 — MMR Diversity Reranking -----------------------------------------
# Maximal Marginal Relevance diversifies dense results before DA expansion.
# lambda=1.0 = pure relevance, lambda=0.0 = pure diversity
MMR_ENABLED=true
MMR_LAMBDA=0.7
MMR_CANDIDATES=50

# -- Phase 4 — SPLADE Hybrid Search -------------------------------------------
# SPLADE adds sparse lexical vectors alongside Jina dense vectors.
# Qdrant combines both with RRF fusion for better keyword + semantic recall.
# Model (~500MB) is downloaded once on first use and cached to MODEL_CACHE_DIR.
#
# ⚠️  Requires re-ingest (changes Qdrant schema to named vectors dense+sparse).
#     GPU VM only — crashes on CPU due to native BERT encoding issue.
SPLADE_ENABLED=false            # set true on GPU VM after re-ingest
SPLADE_MODEL=naver/splade-cocondenser-selfdistil
USE_STUB_SPLADE=false           # set true to skip model download in unit tests

# Card generation parallelism
# Each worker sends one Ollama request concurrently.
# Increase on a GPU VM where Ollama can serve parallel requests:
#   GPU VM recommendation: CARD_GEN_WORKERS=8
#   CPU laptop:            CARD_GEN_WORKERS=2
CARD_GEN_WORKERS=4

# -- RAPTOR -- Phase 2 ---------------------------------------------------------
RAPTOR_MAX_LEVELS=3
RAPTOR_MIN_CLUSTER_SIZE=2       # minimum chunks per cluster

# -- Phase 3 — ColPali visual embeddings ---------------------------------------
# ColPali encodes each PDF page as a matrix of patch vectors (late-interaction).
# The model (~5 GB) is downloaded once to MODEL_CACHE_DIR on first run.
COLPALI_MODEL=vidore/colpali-v1.2
COLPALI_COLLECTION=visual_knowledge_base
CONCEPT_COLLECTION=concept_embeddings   # Qdrant collection for fast GraphRAG concept lookup
COLPALI_PATCH_DIM=128
# ColPali page batching — pages loaded into RAM and embedded at a time.
# Keep low on CPU/low-RAM machines; increase on GPU VM with more VRAM.
#   Local CPU:  COLPALI_PAGE_BATCH_SIZE=2
#   GPU VM:     COLPALI_PAGE_BATCH_SIZE=16
COLPALI_PAGE_BATCH_SIZE=4
PAGE_IMAGES_DIR=./data/page_images

# Image storage backend: "local" (default) stores PNGs on disk.
# Set "minio" to use the docker-compose MinIO service instead.
IMAGE_STORE_BACKEND=local

# MinIO (only needed when IMAGE_STORE_BACKEND=minio)
# Start with: docker compose --profile phase3 up -d
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=synapse
MINIO_SECRET_KEY=synapse123
MINIO_BUCKET=page-images

# -- Phase 3 — Memgraph GraphRAG -----------------------------------------------
# Start Memgraph with: docker compose --profile phase3 up -d
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=synapse
USE_STUB_GRAPH=false            # Set true to skip Memgraph in unit tests

# Concept extraction parallelism (same pattern as CARD_GEN_WORKERS)
# Each worker sends one Ollama request concurrently for concept extraction.
#   GPU VM recommendation: CONCEPT_GEN_WORKERS=8
#   CPU laptop:            CONCEPT_GEN_WORKERS=2
CONCEPT_GEN_WORKERS=4

# -- Multi-tenancy -------------------------------------------------------------
GLOBAL_TENANT_ID=global         # tenant_id used for the base textbook

# -- File paths ----------------------------------------------------------------
MODEL_CACHE_DIR=./data/models
UPLOAD_DIR=./data/user_uploads
BASE_TEXTBOOK_DIR=./data/base_textbooks

# -- Phoenix Arize observability (Phase E) -------------------------------------
# Set PHOENIX_ENABLED=true to send traces to a running Phoenix server.
# Start the server: pip install arize-phoenix && phoenix serve
# Dashboard at http://localhost:6006
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://localhost:6006
