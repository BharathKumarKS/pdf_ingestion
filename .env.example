# Synapse Learning Worlds -- Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -- App -----------------------------------------------------------------------
APP_NAME="Synapse Learning Worlds"
APP_VERSION="0.1.0"
DEBUG=false

# -- Database ------------------------------------------------------------------
SQLITE_URL="sqlite:///./data/synapse.db"

# -- Qdrant Vector DB ----------------------------------------------------------
# Option A: Local file-based persistence (default, no Docker required for dev)
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=knowledge_base
QDRANT_IN_MEMORY=false          # Set true for unit tests (overrides QDRANT_LOCAL_PATH)

# Option B: Remote cluster (Support Vectors / Qdrant Cloud)
# Fill in QDRANT_URL and QDRANT_API_KEY from your Support Vectors dashboard.
# When QDRANT_URL is set it takes priority over QDRANT_LOCAL_PATH.
# Leave blank to use local mode (Option A above).
QDRANT_URL=                     # e.g. https://abc123xyz.cloud.qdrant.io
QDRANT_API_KEY=                 # e.g. your-api-key-from-support-vectors-dashboard

# NOTE: The collection is NEVER deleted. If it already exists in the remote
# cluster, the pipeline will reuse it and upsert new vectors alongside existing ones.

# -- Embedding -- Jina v3 ------------------------------------------------------
# Downloads ~570 MB on first run, cached to MODEL_CACHE_DIR
EMBEDDING_MODEL=jinaai/jina-embeddings-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8          # CPU default; set 32 on GPU VM
USE_GPU=false                   # Set true on Support Vectors GPU VM (CUDA)
USE_STUB_EMBEDDER=false         # Set true for fast unit tests (random vectors)

# -- Chunking ------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_TOKENS=32

# -- Ollama / LLM -- Phase 2 ---------------------------------------------------
# Requires: ollama serve && ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120              # seconds per generation call
USE_STUB_LLM=false              # Set true for fast unit tests (no Ollama needed)

# Card generation parallelism
# Each worker sends one Ollama request concurrently.
# Increase on a GPU VM where Ollama can serve parallel requests:
#   GPU VM recommendation: CARD_GEN_WORKERS=8
#   CPU laptop:            CARD_GEN_WORKERS=2
CARD_GEN_WORKERS=4

# -- RAPTOR -- Phase 2 ---------------------------------------------------------
RAPTOR_MAX_LEVELS=3
RAPTOR_MIN_CLUSTER_SIZE=2       # minimum chunks per cluster

# -- Phase 3 — ColPali visual embeddings ---------------------------------------
# ColPali encodes each PDF page as a matrix of patch vectors (late-interaction).
# The model (~5 GB) is downloaded once to MODEL_CACHE_DIR on first run.
COLPALI_MODEL=vidore/colpali-v1.2
COLPALI_COLLECTION=visual_knowledge_base
COLPALI_PATCH_DIM=128
USE_STUB_COLPALI=false          # Set true to skip model download in unit tests
PAGE_IMAGES_DIR=./data/page_images

# Image storage backend: "local" (default) stores PNGs on disk.
# Set "minio" to use the docker-compose MinIO service instead.
IMAGE_STORE_BACKEND=local

# MinIO (only needed when IMAGE_STORE_BACKEND=minio)
# Start with: docker compose --profile phase3 up -d
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=synapse
MINIO_SECRET_KEY=synapse123
MINIO_BUCKET=page-images

# -- Phase 3 — Memgraph GraphRAG -----------------------------------------------
# Start Memgraph with: docker compose --profile phase3 up -d
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=synapse
USE_STUB_GRAPH=false            # Set true to skip Memgraph in unit tests

# -- Multi-tenancy -------------------------------------------------------------
GLOBAL_TENANT_ID=global         # tenant_id used for the base textbook

# -- File paths ----------------------------------------------------------------
MODEL_CACHE_DIR=./data/models
UPLOAD_DIR=./data/user_uploads
BASE_TEXTBOOK_DIR=./data/base_textbooks
