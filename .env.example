# ── App ──────────────────────────────────────────────────────
APP_NAME="Synapse Learning Worlds"
APP_VERSION="0.1.0"
DEBUG=false

# ── Database ─────────────────────────────────────────────────
SQLITE_URL="sqlite:///./data/synapse.db"

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base
QDRANT_IN_MEMORY=false          # Set true for tests (no Docker needed)

# ── Embedding (Jina v3) ──────────────────────────────────────
EMBEDDING_MODEL=jinaai/jina-embeddings-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8
USE_GPU=false
USE_STUB_EMBEDDER=false         # Set true for fast unit tests

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_TOKENS=32

# ── Tenancy ──────────────────────────────────────────────────
GLOBAL_TENANT_ID=global

# ── Paths ────────────────────────────────────────────────────
MODEL_CACHE_DIR=./data/models
UPLOAD_DIR=./data/user_uploads
BASE_TEXTBOOK_DIR=./data/base_textbooks
