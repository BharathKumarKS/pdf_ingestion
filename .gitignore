# but ignore the build cache
.uv/

# ── Secrets & local config ────────────────────────────────────────────────
.env
.env.local
*.pem
*.key

# ── Data directories (large / generated at runtime) ──────────────────────
data/qdrant/
data/models/
data/user_uploads/
data/base_textbooks/
data/*.db
data/test_*.db

# ── Test artefacts ─────────────────────────────────────────────────────────
tests/data/
.pytest_cache/
.coverage
htmlcov/

# ── Logs ─────────────────────────────────────────────────────────────────
/tmp/streamlit.log
*.log

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Claude Code workspace ─────────────────────────────────────────────────
.claude/

