# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual environment ───────────────────────────────────────────────────
.venv/
venv/
env/

# ── uv ────────────────────────────────────────────────────────────────────
# Keep uv.lock committed (deterministic installs)
# but ignore the build cache
.uv/

# ── Secrets & local config ────────────────────────────────────────────────
.env
.env.local
# Any backup of .env carries real credentials (MEMGRAPH_PASSWORD, QDRANT_API_KEY).
# The bare `.env` pattern does NOT match these — they must be listed explicitly.
.env.bak*
.env.backup*
.env.*.bak
*.pem
*.key

# ── Data directories (large / generated at runtime) ──────────────────────
data/qdrant/
# Only ever produced by the embedded-storage bind-mount experiment, which cannot
# work (qdrant_client.local is a Python emulation, not the Rust server). 4.4 GB —
# must never be committed.
data/qdrant_server/
# HF model caches are multi-GB and must never be committed — so ignore everything
# under data/models/ EXCEPT the small trained intent-classifier pickle, which is
# part of the reproducible baseline (P0 item 3). A missing classifier silently
# degrades the router to prototype mode; tracking it makes that state explicit.
data/models/*
!data/models/intent_classifier.pkl
data/user_uploads/
data/base_textbooks/
data/*.db
# DB backups written by scripts/align_stores.py (and any future re-keying script) are
# ~140 MB each and `data/*.db` does NOT match them — the name ends in the timestamp.
data/*.db.bak-*
data/test_*.db

# ── Test artefacts ─────────────────────────────────────────────────────────
# `tests/data/*` (not `tests/data/`) so the negation below can re-include files —
# git never descends into an excluded directory, so a `!` rule under `tests/data/`
# would be silently ignored. Same shape as the data/models rule above.
tests/data/*
# …but small JSON fixtures ARE tracked: they are hand-checked golden files, not
# generated artefacts (e.g. tests/data/formula_split_golden.json, used by
# tests/test_frontend_formula_render.py).
!tests/data/*.json
.pytest_cache/
.coverage
htmlcov/

# ── Logs ─────────────────────────────────────────────────────────────────
/tmp/streamlit.log
*.log

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Claude Code workspace ─────────────────────────────────────────────────
.claude/

# ── Aider (AI coding assistant) ───────────────────────────────────────────
.aider*
.aider.tags.cache.v4/

# ── Streamlit ─────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
data/page_images/
data/intent_classifier/
# The late-chunk resume cache (IMPROVEMENTS.md §I19): derived, re-derivable, and keyed by a
# fingerprint over the PDF plus the chunking config — so it is machine-local by nature and
# committing it would only pin one machine's corpus state.
data/embed_cache/
data/card_cache/
# data/eval_results/ is deliberately NOT ignored — these artifacts ARE the regression
# baseline the project compares against, and the "Definition of done" requires the run's
# artifact to be committed. Ignoring this directory is why the report's "v10" figure had
# no artifact on disk, and no past run (v7/v8/v9) could be diffed against a later one.
# Whole history is ~660 KB across 43 files.
#
# Exception: the judge verdict cache is a *working* file, not a report. Its purpose is
# resume + bit-identical re-runs (see validate_eval_calibration.VerdictCache); it is
# append-only, reaches ~6 MB / 29k rows in one P0-9 session, and the labels it produced
# are committed separately. Tracked once by accident (commit 38c9f79) — ignored here.
data/eval_results/.scan_verdict_cache.jsonl
data/ingest_log.txt
minio/

# SV cluster access sample package (vendored, not ours to version)
sv_ray_cluster_access/

# P1 Step 6 probe working files: the cached Docling parse (~2 MB, re-derivable with
# `--children-cache`, and it would otherwise change on every re-parse) and the run's stderr log.
# The probe, its JSON output and the README ARE tracked — they are the evidence.
logs/p1/step6/children.json
logs/p1/step6/realbook.err

# P1 Step 7 probe working file: the throwaway SQLite the probe ingests into (~190 KB,
# regenerated on every run). The probe, its JSON output and the README ARE tracked.
logs/p1/step7/probe.db

# Hermes agent session artifacts. Plans are deliverables (HANDOFF.md points a fresh
# session at them), so they are tracked; anything else Hermes writes here is churn.
.hermes/*
!.hermes/plans/
!.hermes/plans/**
