 "texts": [
  {
   "id": "text_vis-001",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the figure that displays water magnified one billion times.",
   "source_page": 37,
   "relevant_pages": [
    37
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "calibration"
  },
  {
   "id": "text_vis-002",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the schematic diagram of DNA from Fig. 3-2.",
   "source_page": 76,
   "relevant_pages": [
    77
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "heldout"
  },
  {
   "id": "text_vis-003",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the diagram of a pendulum (Fig.\u202f4\u20117) that displays the bob, string, and the angle of swing.",
   "source_page": 94,
   "relevant_pages": [
    94
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "calibration"
  },
  {
   "id": "text_vis-005",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the graph that plots the fraction of heads versus the number of tosses N for a particular sequence of penny tosses.",
   "source_page": 129,
   "relevant_pages": [
    130
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "heldout"
  },
  {
   "id": "text_vis-006",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the diagram of the apparatus that demonstrates the independence of vertical and horizontal motions.",
   "source_page": 145,
   "relevant_pages": [
    144,
    370,
    374
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "calibration"
  },
  {
   "id": "text_vis-007",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Locate the figure that illustrates the Cavendish torsion balance apparatus, showing the horizontal rod with two small masses suspended by a wire, and the two large masses positioned nearby to create the gravitational attraction for measuring G.",
   "source_page": 155,
   "relevant_pages": [
    154
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "heldout"
  },
  {
   "id": "text_vis-008",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the diagram of a parabolic trajectory of a falling body launched with an initial horizontal velocity, including axes labeled \\(x\\) and \\(y\\) and the parabola curve (Fig. 8\u20114).",
   "source_page": 176,
   "relevant_pages": [
    176
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "calibration"
  },
  {
   "id": "text_vis-010",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Find the figure that illustrates the addition of vectors by placing the tail of one vector at the head of the other, forming a parallelogram.",
   "source_page": 223,
   "relevant_pages": [
    222
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "heldout"
  },
  {
   "id": "text_vis-011",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the diagram of the closed path in a gravitational field from Fig. 13-3.",
   "source_page": 257,
   "relevant_pages": [
    257
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "calibration"
  },
  {
   "id": "text_vis-012",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show the diagram that illustrates the coordinate transformation between the stationary system and the moving system (the primed and unprimed coordinate axes) used to demonstrate that Newton\u2019s laws retain the same form in both frames.",
   "source_page": 286,
   "relevant_pages": [
    214,
    217,
    218,
    285
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "heldout"
  },
  {
   "id": "text_vis-013",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show the diagram of the torque produced by a force, including the force vector, the point of application, the lever arm, and the angle between the force direction and the lever arm.",
   "source_page": 339,
   "relevant_pages": [
    339
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "calibration"
  },
  {
   "id": "text_vis-014",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the diagram illustrating the two coordinate systems where the z- and z\u2032-axes coincide and one system is rotated by a fixed angle \u03b8 relative to the other.",
   "source_page": 364,
   "relevant_pages": [
    217,
    218
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "heldout"
  },
  {
   "id": "text_vis-015",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the figure of the actual motion of the tip of the axis of the gyroscope under gravity after the axis was released.",
   "source_page": 374,
   "relevant_pages": [
    374
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "calibration"
  },
  {
   "id": "text_vis-018",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the figure of a light ray reflecting off a surface where the angle of incidence equals the angle of reflection.",
   "source_page": 454,
   "relevant_pages": [
    454,
    457
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "heldout"
  },
  {
   "id": "text_vis-019",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the diagram of the paraboloidal mirror, including its focal point and axis of symmetry.",
   "source_page": 464,
   "relevant_pages": [
    464
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "calibration"
  },
  {
   "id": "text_vis-020",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the diagram of a thin lens with two positive radii, including the labels for the lens surfaces and the two positive radii of curvature.",
   "source_page": 478,
   "relevant_pages": [
    477
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "heldout"
  },
  {
   "id": "text_vis-021",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the diagram of the two-antenna system (Fig. 29\u20116) that illustrates the amplitude pattern with the N antenna one\u2011quarter wavelength apart from the S antenna and one\u2011fourth period behind it, indicating that the W direction has amplitude 2 and the S direction has amplitude 0.",
   "source_page": 504,
   "relevant_pages": [
    504
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "calibration"
  },
  {
   "id": "text_vis-022",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Find the figure that shows a linear array of n equal oscillators driven with phases s = s.",
   "source_page": 515,
   "relevant_pages": [
    506,
    515
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "heldout"
  },
  {
   "id": "text_vis-026",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the diagram of a charged particle moving in a circular (or helical) path in a uniform magnetic field, including the velocity vector, magnetic field direction, and radius of curvature.",
   "source_page": 594,
   "relevant_pages": [
    593
   ],
   "why": "labelled visual query (text description of a real figure)",
   "split": "calibration"
  },
  {
   "id": "text_vis-027",
   "group": "text_vis_query",
   "modality": "text",
   "text": "Show me the diagram of the wavefronts of a wave traveling at an angle to the coordinate axes, as illustrated in Fig. 34-11.",
   "source_page": 604,
   "relevant_pages": [
    604
